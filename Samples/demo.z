# ============================================
# zunjin 语言示例脚本 - demo.z
# 演示：变量、when 分支、循环、自定义函数
# .z 文件 = zunjin 语言用户脚本
# ============================================

# ---------- 1. 变量与基本运算 ----------
put("===== 1. 变量与基本运算 =====")

x = 42
y = 10
name = "zunjin"
pi = 3.14

put("x =", x)
put("y =", y)
put("name =", name)
put("pi =", pi)

# 算术运算
sum_val = x + y
diff = x - y
product = x * y
quotient = x / y
int_div = x // y
remainder = x % y

put("x + y =", sum_val)
put("x - y =", diff)
put("x * y =", product)
put("x / y =", quotient)
put("x // y =", int_div)
put("x % y =", remainder)

# 字符串拼接
greeting = "Hello, " + name + "!"
put(greeting)

# 布尔值
is_big = x > y
is_equal = x == y
put("x > y is", is_big)
put("x == y is", is_equal)

# ---------- 2. when 条件判断 ----------
put("")
put("===== 2. when 条件判断 =====")

score = 85

when score >= 90:
    put("成绩: 优秀")
whenelse score >= 80:
    put("成绩: 良好")
whenelse score >= 60:
    put("成绩: 及格")
otherwise:
    put("成绩: 不及格")

# 多条件组合
when x > 0 both y > 0:
    put("x 和 y 都是正数")

when x > 100 either y > 5:
    put("至少一个条件成立")

# ---------- 3. loop 循环 ----------
put("")
put("===== 3. loop 循环 =====")

count = 1
loop count <= 5:
    put("loop 计数:", count)
    count = count + 1

# stop 和 next
put("--- stop 演示 ---")
n = 0
loop n < 10:
    n = n + 1
    when n == 3:
        next
    when n == 7:
        stop
    put("n =", n)

# ---------- 4. foreach 循环 ----------
put("")
put("===== 4. foreach 循环 =====")

put("--- upto 遍历 ---")
foreach i of upto(5):
    put("i =", i)

put("--- upto 指定范围 ---")
foreach j of upto(3, 8):
    put("j =", j)

# ---------- 5. 自定义函数 ----------
put("")
put("===== 5. 自定义函数 =====")

# 定义阶乘函数
proc factorial(n):
    when n <= 1:
        give 1
    give n * factorial(n - 1)

# 调用阶乘函数
put("5! =", factorial(5))
put("7! =", factorial(7))

# 定义斐波那契函数
proc fibonacci(n):
    when n <= 1:
        give n
    a = 0
    b = 1
    i = 2
    loop i <= n:
        temp = a + b
        a = b
        b = temp
        i = i + 1
    give b

# 打印斐波那契数列前 10 项
put("--- 斐波那契数列前 10 项 ---")
foreach k of upto(10):
    put("fib(", k, ") =", fibonacci(k))

# 定义带多个参数的函数
proc add(a, b, c):
    give a + b + c

result = add(10, 20, 30)
put("add(10, 20, 30) =", result)

# ---------- 6. 综合演示 ----------
put("")
put("===== 6. 综合演示 =====")

# 打印乘法表
put("--- 乘法表 ---")
row = 1
loop row <= 9:
    col = 1
    line = ""
    loop col <= row:
        when col > 1:
            line = line + "  "
        line = line + text(col) + "x" + text(row) + "=" + text(col * row)
        col = col + 1
    put(line)
    row = row + 1

# 判断素数
proc is_prime(n):
    when n < 2:
        give no
    i = 2
    loop i * i <= n:
        when n % i == 0:
            give no
        i = i + 1
    give yes

put("--- 1-20 中的素数 ---")
foreach num of upto(1, 21):
    when is_prime(num):
        put(num, "是素数")

put("")
put("===== zunjin 脚本执行完毕 =====")