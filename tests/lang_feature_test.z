# ============================================================
# zunjin 语言功能测试（对照主流脚本语言特性）
# 覆盖：字面量/运算符/流程控制/函数/集合/异常/新内置函数
# ============================================================

put("===== 1. 数值字面量与进制 =====")
put(0x1F)            # 31
put(0o17)            # 15
put(0b1010)          # 10
put(1_000_000)       # 1000000
put(1.5e3)           # 1500.0
put(2.5e-2)          # 0.025

put("===== 2. 整数运算（zunjin 语义） =====")
put(7 - 3)           # 4  (int)
put(7 * 3)           # 21 (int)
put(7 / 2)           # 3.5 (float)
put(typeof(7 / 2))   # float
put(-7 // 2)         # -4 (向下取整)
put(7 // -2)         # -4
put(-7 % 3)          # 2  (符号与除数一致)
put(7 % -3)          # -2
put(2 ** 10)         # 1024
put(-2 ** 2)         # -4 (幂优先于一元负号)
put(5 & 3)           # 1
put(5 | 3)           # 7
put(5 ^ 3)           # 6
put(1 << 4)          # 16
put(256 >> 4)        # 16
put(~5)              # -6

put("===== 3. 短路逻辑 =====")
put(0 both 100)       # 0
put(1 both 100)       # 100
put(1 either 100)        # 1
put(0 either 100)        # 100
put(1 both 2 both 3)   # 3
put(0 either "" either "x")  # x

put("===== 4. 字符串操作 =====")
s = "hello world"
put(s[0])            # h
put(s[-1])           # d
put(s[0:5])          # hello
put(s[6:])           # world
put(s[::-1])         # dlrow olleh
put(s[::2])          # hlowrd
put("ab" + "cd")     # abcd
put("ha" * 3)        # hahaha
put("ell" of s)      # yes
put("xyz" negate of s)  # yes
put(upper(s))        # HELLO WORLD
put(lower("ABC"))    # abc
put(strip("  pad  "))        # pad
put(replace(s, "world", "zunjin"))  # hello zunjin
put(split("a,b,c", ","))     # [a, b, c]
put(split("  a  b  "))       # [a, b]
put(join("-", ["a", "b", "c"]))  # a-b-c
put(find(s, "world"))        # 6
put(find(s, "zzz"))          # -1
put(startswith(s, "hello"))  # yes
put(endswith(s, "world"))    # yes
put(count("banana", "an"))   # 2
put(ord("A"))                # 65
put(chr(66))                 # B
put(hex(255))                # 0xff
put(bin(5))                  # 0b101
put(oct(8))                  # 0o10

put("===== 5. 三引号字符串 =====")
t = """第一行
第二行"""
put(t)
t2 = '''单引号三引号'''
put(t2)

put("===== 6. 列表操作 =====")
lst = [3, 1, 2]
push(lst, 4)
put(lst)             # [3, 1, 2, 4]
put(pop(lst))        # 4
put(lst)             # [3, 1, 2]
put(pop(lst, 0))     # 3
put(lst)             # [1, 2]
insert(lst, 1, 99)
put(lst)             # [1, 99, 2]
erase(lst, 99)
put(lst)             # [1, 2]
delete(lst, 0)
put(lst)             # [2]
put(sort([5, 3, 8, 1]))   # [1, 3, 5, 8]
put(reverse([1, 2, 3]))   # [3, 2, 1]
put(minimum(5, 3, 9))     # 3
put(minimum([5, 3, 9]))   # 3
put(maximum(5, 3, 9))     # 9
put(maximum([5, 3, 9]))   # 9
put(total(1, 2, 3))       # 6
put(total([1, 2, 3]))     # 6
put(total([1.5, 2.5]))    # 4.0
lst[0] = 7                 # 索引赋值
put(lst)                  # [7, 2]
extend(lst, [8, 9])
put(lst)                  # [7, 2, 8, 9]
put(count([1, 2, 1, 1], 1))  # 3
put(index(["a", "b", "c"], "b"))  # 1
clear(lst)
put(lst)                  # []
put([1, 2, 3] * 2)        # [1, 2, 3, 1, 2, 3]
put([1, 2] + [3, 4])      # [1, 2, 3, 4]
put(3 of [1, 2, 3])       # yes

put("===== 7. 字典 =====")
d = {"name": "zunjin", "age": 1, "ver": 2.0}
put(d)
put(d["name"])            # zunjin
d["age"] = 2
put(d["age"])             # 2
put("name" of d)          # yes
put("nope" of d)          # no
put(size(d))              # 3
put(keys(d))              # [name, age, ver]
put(values(d))            # [zunjin, 2, 2.0]
foreach k of d:
    put(k)

put("===== 8. 复合赋值 =====")
x = 10
x += 5
put(x)                    # 15
x -= 3
put(x)                    # 12
x *= 2
put(x)                    # 24
x //= 5
put(x)                    # 4
x **= 3
put(x)                    # 64
x %= 7
put(x)                    # 1
str1 = "ab"
str1 += "cd"
put(str1)                 # abcd
y = 1.5
y += 2
put(y)                    # 3.5

put("===== 9. 函数与默认参数 =====")
proc add(a, b):
    give a + b
put(add(3, 4))            # 7

proc greet(name, msg = "hello"):
    give msg + ", " + name
put(greet("zunjin"))      # hello, zunjin
put(greet("zunjin", "hi"))  # hi, zunjin

proc fact(n):
    when n <= 1:
        give 1
    give n * fact(n - 1)
put(fact(10))             # 3628800

proc fib(n):
    when n < 2:
        give n
    give fib(n - 1) + fib(n - 2)
put(fib(15))              # 610

put("===== 10. 切片进阶 =====")
nums = upto(10)
put(nums)                 # [0..9]
put(nums[2:8:2])          # [2, 4, 6]
put(nums[8:2:-2])         # [8, 6, 4]
put(nums[::-1])           # 逆序
put(nums[-3:])            # [7, 8, 9]
put(nums[:-5])            # [0..4]
put(nums[::3])            # [0, 3, 6, 9]

put("===== 11. 异常处理 =====")
attempt:
    x1 = 10 / 0
seize err:
    put("捕获: " + err)
settle:
    put("finally 执行")

attempt:
    fling "自定义错误"
seize err2:
    put("捕获2: " + err2)

attempt:
    attempt:
        fling "内层错误"
    seize inner:
        put("内层捕获: " + inner)
    fling "外层错误"
seize outer:
    put("外层捕获: " + outer)

put("===== 12. 迭代器组合 =====")
put(enumerate(["a", "b", "c"]))
put(zip([1, 2, 3], ["x", "y", "z"]))
foreach item of enumerate("ab"):
    put(item)

put("===== 13. 数学函数 =====")
put(round(3.14159, 2))    # 3.14
put(round(2.5))           # 2 (银行家舍入)
put(sqrt(16))             # 4.0
put(power(2, 8))          # 256.0
put(floor(3.7))           # 3
put(ceiling(3.2))         # 4
put(absolute(-42))        # 42

put("===== 14. 递归深度限制（不崩溃） =====")
proc forever(n):
    give forever(n + 1)
attempt:
    forever(0)
seize err3:
    put("深度限制生效: " + err3)

put("===== 15. 未闭合字符串报错（不崩溃） =====")
put("===== 16. 回归：列表悬垂指针 =====")
proc make_list():
    give [1, 2, 3]
a1 = make_list()
a2 = a1
put(a1)
put(a2)
a1 = [9, 9]
put(a2)                   # 仍为 [1, 2, 3]

put("===== 17. loop/stop/next =====")
i = 0
loop i < 5:
    i = i + 1
    when i == 2:
        next
    when i > 4:
        stop
    put(i)

put("===== 18. 内置函数遍历字符串 =====")
foreach ch of "zjn":
    put(ch)

put("===== 全部测试执行完毕 =====")
